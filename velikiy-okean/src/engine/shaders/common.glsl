// common.glsl — shared math, hashing and noise helpers.
// Written from scratch for this project. Hash: PCG-style integer hash (Jarzynski & Olano, JCGT 2020, algorithm).

const float PI = 3.14159265359;
const float TAU = 6.28318530718;

uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 hash3i(ivec3 p) { return vec3(pcg3d(uvec3(p))) * (1.0 / 4294967295.0); }
float hash2i(ivec2 p) { return float(pcg3d(uvec3(p, 1337)).x) * (1.0 / 4294967295.0); }

float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec3 saturate(vec3 x) { return clamp(x, 0.0, 1.0); }
float sq(float x) { return x * x; }
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
mat2 rot2(float a) { float c = cos(a), s = sin(a); return mat2(c, s, -s, c); }

float smin(float a, float b, float k) {
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}
float smax(float a, float b, float k) { return -smin(-a, -b, k); }

// --- SDF primitives (standard geometry) ---
float sdSphere(vec3 p, float r) { return length(p) - r; }
float sdEllipsoid(vec3 p, vec3 r) {  // bound-correct approximation
    float k0 = length(p / r);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 1e-6);
}
float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}
// tapered capsule from a (radius ra) to b (radius rb)
float sdTaper(vec3 p, vec3 a, vec3 b, float ra, float rb) {
    vec3 pa = p - a, ba = b - a;
    float l2 = max(dot(ba, ba), 1e-8);
    float h = clamp(dot(pa, ba) / l2, 0.0, 1.0);
    return length(pa - ba * h) - mix(ra, rb, h);
}
float sdRoundBox(vec3 p, vec3 b, float r) {
    vec3 q = abs(p) - b + r;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}

// --- noise (textures are tileable, generated by noisetex.py) ---
uniform sampler3D uN3;
uniform sampler2D uN2;
float n3(vec3 p) { return texture(uN3, p).r * 2.0 - 1.0; }
vec4 n3v(vec3 p) { return texture(uN3, p) * 2.0 - 1.0; }
vec4 n2v(vec2 p) { return texture(uN2, p) * 2.0 - 1.0; }

// smooth value noise in 2D (procedural, for small scale detail without texture lookups)
float vnoise2(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    ivec2 ii = ivec2(i);
    float a = hash2i(ii), b = hash2i(ii + ivec2(1, 0)), c = hash2i(ii + ivec2(0, 1)), d = hash2i(ii + ivec2(1, 1));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
}

// Henyey-Greenstein phase
float phaseHG(float c, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * c, 1e-4), 1.5));
}
float fresnelSchlick(float cosT, float f0) { return f0 + (1.0 - f0) * pow(1.0 - saturate(cosT), 5.0); }
float ggxD(float nh, float a) { float a2 = a * a; float d = nh * nh * (a2 - 1.0) + 1.0; return a2 / (PI * d * d); }
